{
  "manifest_version": 3,
  "name": "Color Scanner Extension",
  "version": "1.0",
  "description": "Scans for green elements and triggers actions.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Activate Color Scanner"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.html",
        "content.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
